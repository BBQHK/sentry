[Unit]
Description=Sentry pan-tilt camera
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Change User, Group, and both paths if the Pi account is not "pi".
# That account must be in the i2c and video groups.
User=pi
Group=pi
WorkingDirectory=/home/pi/sentry
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/pi/sentry/.venv/bin/python -m sentry
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
