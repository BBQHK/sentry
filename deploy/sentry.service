[Unit]
Description=Sentry pan-tilt camera
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Same Pi account as Hamster Monitor. It must be in the i2c and video groups.
User=king
WorkingDirectory=/home/king/Desktop/sentry
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/king/Desktop/sentry/.venv/bin/python -m sentry
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
